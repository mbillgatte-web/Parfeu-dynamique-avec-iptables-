# Copie ce fichier en ".env" pour le dev local, ou configure ces variables
# directement dans les "Variables" de ton service Railway.

# Clé secrète Django (génère-en une nouvelle pour la prod, ne réutilise jamais celle de dev)
SECRET_KEY=change-moi-en-production

# Ne jamais mettre True en production
DEBUG=False

# Domaine(s) autorisés, séparés par des virgules (ex: monapp.up.railway.app)
ALLOWED_HOSTS=

# Fournie automatiquement par Railway si tu ajoutes un plugin PostgreSQL
# (variable de référence: ${{Postgres.DATABASE_URL}}). Laisse vide pour SQLite en local.
DATABASE_URL=

# Clé API Anthropic utilisée par le chatbot IA (superAdmin/chatbot_ia.py)
ANTHROPIC_API_KEY=
